# ============================================
# ETEX Game — Docker Environment Variables
# ============================================
# Copy this file to .env before running docker compose up

# ── PostgreSQL ───────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=etex_game

# ── Backend ──────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
BACKEND_PORT=5001

# ── Frontend (Next.js) ──────────────────────
FRONTEND_PORT=3000

# ── Admin Dashboard ─────────────────────────
ADMIN_PORT=8080

# ── Nginx (unified entry) ──────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ── Database (mapped host port) ─────────────
DB_PORT=5433
